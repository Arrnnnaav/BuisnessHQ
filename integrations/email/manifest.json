{
  "id": "email",
  "name": "Email Service Integration",
  "version": "1.0.0",
  "description": "Integration with email services (SMTP, SendGrid, Mailgun, etc.) for reliable email delivery",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": false,
      "settingsPage": true,
      "navigationItem": false
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "email",
    "campaigns"
  ],
  "permissions": {
    "required": [
      "read:email_service",
      "write:email_service",
      "execute:email_sending",
      "execute:deliverability_monitoring"
    ],
    "optional": [
      "execute:email_validation",
      "execute:list_cleaning",
      "execute:spam_complaint_handling",
      "read:email",
      "write:email",
      "read:campaigns",
      "write:campaigns"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js
  },
  "assets": {
    "icon": "/assets/icons/email-integration.svg",
    "screenshots": [
      "/assets/screenshots/email-integration-dashboard.png",
      "/assets/screenshots/smtp-configuration.png",
      "/assets/screenshots/email-delivery-analytics.png"
    ]
  },
  "keywords": [
    "businessos",
    "integration",
    "email",
    "smtp",
    "sendgrid",
    "mailgun",
    "delivery",
    "deliverability",
    "validation"
  ],
  "category": "utility"
}