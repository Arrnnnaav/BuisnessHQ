{
  "id": "website",
  "name": "Website Integration & Crawler",
  "version": "1.0.0",
  "description": "Website integration system for crawling, monitoring, and synchronizing with external websites",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": false,
      "settingsPage": true,
      "navigationItem": false
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "website",
    "seo",
    "analytics"
  ],
  "permissions": {
    "required": [
      "read:website_external",
      "write:website_external",
      "execute:website_crawling",
      "execute:change_detection",
      "execute:content_extraction"
    ],
    "optional": [
      "execute:performance_monitoring",
      "execute:uptime_monitoring",
      "execute:security_scanning",
      "read:website",
      "write:website",
      "read:seo",
      "write:seo",
      "read:analytics",
      "write:analytics"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js
  },
  "assets": {
    "icon": "/assets/icons/website-integration.svg",
    "screenshots": [
      "/assets/screenshots/website-crawler.png",
      "/assets/screenshots/change-detection.png",
      "/assets/screenshots/content-extraction.png"
    ]
  },
  "keywords": [
    "businessos",
    "integration",
    "website",
    "crawler",
    "monitoring",
    "change-detection",
    "content-extraction",
    "performance",
    "uptime",
    "security"
  ],
  "category": "utility"
}