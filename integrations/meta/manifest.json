{
  "id": "meta",
  "name": "Meta (Facebook/Instagram) Integration",
  "version": "1.0.0",
  "description": "Integration with Facebook and Instagram for social media management, advertising, and insights",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": false,
      "settingsPage": true,
      "navigationItem": false
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "social",
    "content",
    "campaigns"
  ],
  "permissions": {
    "required": [
      "read:facebook_pages",
      "write:facebook_pages",
      "read:instagram_accounts",
      "write:instagram_accounts",
      "execute:fb_content_publishing",
      "execute:ig_content_publishing",
      "read:facebook_ads",
      "write:facebook_ads"
    ],
    "optional": [
      "read:facebook_insights",
      "write:facebook_insights",
      "read:instagram_insights",
      "write:instagram_insights",
      "execute:fb_lead_ads",
      "execute:ig_shopping",
      "read:messenger",
      "write:messenger"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js
  },
  "assets": {
    "icon": "/assets/icons/meta.svg",
    "screenshots": [
      "/assets/screenshots/meta-integration-dashboard.png",
      "/assets/screenshots/facebook-integration.png",
      "/assets/screenshots/instagram-integration.png"
    ]
  },
  "keywords": [
    "businessos",
    "integration",
    "meta",
    "facebook",
    "instagram",
    "social-media",
    "advertising",
    "insights",
    "messenger"
  ],
  "category": "utility"
}