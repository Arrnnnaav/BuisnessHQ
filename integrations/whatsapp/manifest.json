{
  "id": "whatsapp",
  "name": "WhatsApp Business API Integration",
  "version": "1.0.0",
  "description": "Integration with WhatsApp Business API for scalable customer communication and notifications",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": false,
      "settingsPage": true,
      "navigationItem": false
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "whatsapp",
    "crm",
    "campaigns"
  ],
  "permissions": {
    "required": [
      "read:whatsapp_api",
      "write:whatsapp_api",
      "execute:message_sending",
      "execute:template_management",
      "execute:session_management"
    ],
    "optional": [
      "execute:broadcast_messaging",
      "execute:interactive_messages",
      "execute:catalog_sharing",
      "read:whatsapp",
      "write:whatsapp",
      "read:crm",
      "write:crm",
      "read:campaigns",
      "write:campaigns"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js
  },
  "assets": {
    "icon": "/assets/icons/whatsapp-integration.svg",
    "screenshots": [
      "/assets/screenshots/whatsapp-integration-dashboard.png",
      "/assets/screenshots/whatsapp-api-configuration.png",
      "/assets/screenshots/whatsapp-message-templates.png"
    ]
  },
  "keywords": [
    "businessos",
    "integration",
    "whatsapp",
    "business-api",
    "messaging",
    "templates",
    "broadcast",
    "interactive"
  ],
  "category": "utility"
}