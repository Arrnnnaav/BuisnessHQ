{
  "id": "quotations",
  "name": "Quotation & Proposal Manager",
  "version": "1.0.0",
  "description": "Professional quotation and proposal generation system with pricing integration, tracking, and follow-up automation",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "quotes-overview",
          "description": "Overview of quotation activity and performance",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "quotes-recent",
          "description": "Recent quotes and follow-up status",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [
    "catalog",
    "pricing"
  ],
  "peerDependencies": [
    "crm",
    "projects",
    "content",
    "analytics",
    "email",
    "whatsapp"
  ],
  "permissions": {
    "required": [
      "read:quotations",
      "write:quotations",
      "execute:quote_creation",
      "execute:quote_tracking",
      "execute:follow_up_automation",
      "read:catalog",
      "read:pricing"
    ],
    "optional": [
      "write:catalog",
      "write:pricing",
      "execute:quote_negotiation",
      "execute:proposal_generation",
      "execute:template_management",
      "read:crm",
      "write:crm",
      "read:projects",
      "write:projects",
      "read:content",
      "write:content",
      "read:analytics",
      "write:analytics",
      "read:email",
      "write:email",
      "read:whatsapp",
      "write:whatsapp"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/quotations.svg",
    "screenshots": [
      "/assets/screenshots/quotations-dashboard.png",
      "/assets/screenshots/quote-detail.png",
      "/assets/screenshots/quote-follow-up.png",
      "/assets/screenshots/proposal-generation.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "quotations",
    "quotes",
    "proposals",
    "sales",
    "pricing-integration",
    "follow-up",
    "templates",
    "negotiation"
  ],
  "category": "business"
}