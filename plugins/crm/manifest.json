{
  "id": "crm",
  "name": "Customer Relationship Manager",
  "version": "1.0.0",
  "description": "Complete CRM system for managing leads, customers, communications, and sales pipeline",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "crm-overview",
          "description": "Overview of sales pipeline and customer metrics",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "crm-pipeline",
          "description": "Real-time sales pipeline and lead tracking",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "quotations",
    "projects",
    "catalog",
    "pricing",
    "content",
    "campaigns",
    "reviews",
    "google_business",
    "seo",
    "analytics"
  ],
  "permissions": {
    "required": [
      "read:crm",
      "write:crm",
      "execute:lead_creation",
      "execute:lead_qualification",
      "execute:opportunity_management"
    ],
    "optional": [
      "write:quotations",
      "write:projects",
      "execute:lead_nurturing",
      "execute:customer_segmentation",
      "execute:forecasting",
      "read:quotations",
      "write:quotations",
      "read:projects",
      "write:projects",
      "read:catalog",
      "write:catalog",
      "read:pricing",
      "write:pricing",
      "read:content",
      "write:content",
      "read:reviews",
      "write:reviews",
      "read:google_business",
      "write:google_business",
      "read:seo",
      "write:seo",
      "read:analytics",
      "write:analytics"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/crm.svg",
    "screenshots": [
      "/assets/screenshots/crm-dashboard.png",
      "/assets/screenshots/crm-pipeline.png",
      "/assets/screenshots/lead-management.png",
      "/assets/screenshots/customer-detail.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "crm",
    "customer-relationship",
    "lead-management",
    "sales-pipeline",
    "opportunity-tracking",
    "customer-service"
  ],
  "category": "business"
}