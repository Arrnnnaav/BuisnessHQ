{
  "id": "analytics",
  "name": "Business Intelligence & Analytics",
  "version": "1.0.0",
  "description": "Comprehensive analytics platform connecting website, marketing, sales, and customer data to measure business performance and ROI",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "analytics-overview",
          "description": "Overview of key business metrics and performance indicators",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "analytics-realtime",
          "description": "Real-time traffic and activity monitoring",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "website",
    "seo",
    "google_business",
    "reviews",
    "crm",
    "quotations",
    "projects",
    "catalog",
    "pricing",
    "content",
    "campaigns",
    "social",
    "whatsapp",
    "email"
  ],
  "permissions": {
    "required": [
      "read:analytics",
      "write:analytics",
      "execute:report_generation",
      "execute:data_analysis",
      "read:website"
    ],
    "optional": [
      "write:website",
      "execute:attribution_modeling",
      "execute:funnel_analysis",
      "execute:cohort_analysis",
      "execute:predictive_analytics",
      "read:seo",
      "write:seo",
      "read:google_business",
      "write:google_business",
      "read:reviews",
      "write:reviews",
      "read:crm",
      "write:crm",
      "read:quotations",
      "write:quotations",
      "read:projects",
      "write:projects",
      "read:catalog",
      "write:catalog",
      "read:pricing",
      "write:pricing",
      "read:content",
      "write:content",
      "read:campaigns",
      "write:campaigns",
      "read:social",
      "write:social",
      "read:whatsapp",
      "write:whatsapp",
      "read:email",
      "write:email"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/analytics.svg",
    "screenshots": [
      "/assets/screenshots/analytics-dashboard.png",
      "/assets/screenshots/analytics-realtime.png",
      "/assets/screenshots/analytics-attribution.png",
      "/assets/screenshots/analytics-funnels.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "analytics",
    "business-intelligence",
    "data-analysis",
    "reporting",
    "attribution",
    "funnels",
    "roi",
    "kpis"
  ],
  "category": "intelligence"
}