{
  "id": "email",
  "name": "Email Marketing & Communication Manager",
  "version": "1.0.0",
  "description": "Complete email management system for professional communication, marketing campaigns, and automated notifications",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "email-overview",
          "description": "Overview of email performance and engagement metrics",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "email-campaigns",
          "description": "Email marketing campaigns and automation",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "content",
    "campaigns",
    "analytics",
    "crm"
  ],
  "permissions": {
    "required": [
      "read:email",
      "write:email",
      "execute:email_creation",
      "execute:email_sending",
      "execute:automation_management"
    ],
    "optional": [
      "execute:list_management",
      "execute:segmentation",
      "execute:a_b_testing",
      "execute:personalization",
      "read:content",
      "write:content",
      "read:campaigns",
      "write:campaigns",
      "read:analytics",
      "write:analytics",
      "read:crm",
      "write:crm"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/email.svg",
    "screenshots": [
      "/assets/screenshots/email-dashboard.png",
      "/assets/screenshots/email-editor.png",
      "/assets/screenshots/email-automation.png",
      "/assets/screenshots/email-campaigns.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "email",
    "marketing",
    "communication",
    "automation",
    "campaigns",
    "newsletter",
    "transactional",
    "templates"
  ],
  "category": "growth"
}
