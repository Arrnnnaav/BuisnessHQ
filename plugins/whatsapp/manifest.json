{
  "id": "whatsapp",
  "name": "WhatsApp Business Manager",
  "version": "1.0.0",
  "description": "Complete WhatsApp Business integration for customer communication, marketing, and service notifications",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "whatsapp-overview",
          "description": "Overview of WhatsApp activity and performance",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "whatsapp-conversations",
          "description": "Recent conversations and message status",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "crm",
    "content",
    "campaigns",
    "analytics"
  ],
  "permissions": {
    "required": [
      "read:whatsapp",
      "write:whatsapp",
      "execute:message_sending",
      "execute:message_automation",
      "execute:template_management"
    ],
    "optional": [
      "execute:broadcast_messaging",
      "execute:catalog_sharing",
      "execute:order_notifications",
      "execute:appointment_reminders",
      "read:crm",
      "write:crm",
      "read:content",
      "write:content",
      "read:campaigns",
      "write:campaigns",
      "read:analytics",
      "write:analytics"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/whatsapp.svg",
    "screenshots": [
      "/assets/screenshots/whatsapp-dashboard.png",
      "/assets/screenshots/whatsapp-chat.png",
      "/assets/screenshots/whatsapp-broadcast.png",
      "/assets/screenshots/whatsapp-template.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "whatsapp",
    "business-messaging",
    "customer-communication",
    "marketing",
    "notifications",
    "templates",
    "broadcast"
  ],
  "category": "growth"
}
