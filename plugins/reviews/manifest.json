{
  "id": "reviews",
  "name": "Review & Reputation Manager",
  "version": "1.0.0",
  "description": "Centralized review monitoring, management, and reputation enhancement across all platforms",
  "author": {
    "name": "BusinessOS Team",
    "email": "team@businessos.example.com"
  },
  "license": "MIT",
  "businessos": {
    "minVersion": "0.1.0",
    "ui": {
      "showInDashboard": true,
      "settingsPage": true,
      "navigationItem": true,
      "widgets": [
        {
          "name": "reviews-overview",
          "description": "Overview of review performance and reputation metrics",
          "position": "top",
          "size": "medium"
        },
        {
          "name": "reviews-breakdown",
          "description": "Detailed breakdown of reviews by platform and sentiment",
          "position": "bottom",
          "size": "large"
        }
      ]
    }
  },
  "dependencies": [],
  "peerDependencies": [
    "google_business",
    "seo",
    "content",
    "projects",
    "crm"
  ],
  "permissions": {
    "required": [
      "read:reviews",
      "write:reviews",
      "execute:review_response_creation",
      "execute:review_analysis",
      "read:customers"
    ],
    "optional": [
      "write:customers",
      "execute:review_request_automation",
      "execute:reputation_analysis",
      "read:google_business",
      "write:google_business",
      "read:seo",
      "write:seo",
      "read:projects",
      "write:projects"
    ]
  },
  "fileStructure": {
    "api": "api/",
    "dashboard": "dashboard/",
    "widgets": "widgets/",
    "tools": "tools/",
    "agents": "agents/",
    "skills": "skills/",
    "workflows": "workflows/",
    "events": "events/",
    "settings": "settings/",
    "migrations": "migrations/",
    "health": "health-checks/"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "update": "node scripts/update.js",
    "healthCheck": "node scripts/health-check.js"
  },
  "assets": {
    "icon": "/assets/icons/reviews.svg",
    "screenshots": [
      "/assets/screenshots/reviews-dashboard.png",
      "/assets/screenshots/reviews-breakdown.png",
      "/assets/screenshots/review-response.png",
      "/assets/screenshots/reputation-trends.png"
    ]
  },
  "keywords": [
    "businessos",
    "plugin",
    "reviews",
    "reputation",
    "customer-feedback",
    "testimonials",
    "ratings",
    "feedback-management"
  ],
  "category": "growth"
}